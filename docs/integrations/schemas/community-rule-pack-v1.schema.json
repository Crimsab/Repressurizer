{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crimsab.github.io/Repressurizer/integrations/schemas/community-rule-pack-v1.schema.json",
  "title": "Repressurizer Community Rule Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "author", "version", "compatibleApp", "dataSources", "collections", "rules", "changelog", "checksum"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "compatibleApp": { "type": "string", "minLength": 1, "maxLength": 80 },
    "dataSources": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "collections": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "config"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "config": {
            "type": "object",
            "required": ["schema", "version", "output", "logic"],
            "properties": {
              "schema": { "const": "repressurizer.customAutoCat" },
              "version": { "const": 1 },
              "output": {
                "type": "object",
                "required": ["categoryName"],
                "properties": { "categoryName": { "type": "string", "minLength": 1, "maxLength": 120 } }
              },
              "logic": {
                "type": "object",
                "required": ["op", "conditions"],
                "properties": {
                  "op": { "enum": ["all", "any"] },
                  "conditions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object" } }
                }
              }
            }
          }
        }
      }
    },
    "changelog": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
    "checksum": { "type": "string", "pattern": "^sum_[a-z0-9]+$" }
  }
}
