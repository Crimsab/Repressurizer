{
  "name": "repressurizer",
  "private": true,
  "version": "0.6.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.29.7",
    "esbuild": "^0.28.2",
    "nanoid": "^3.3.18",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sam-sidecar": "bun scripts/build-sam-sidecar.ts",
    "build:linux": "bun tauri build --bundles deb,appimage",
    "build:macos": "bun tauri build --bundles app,dmg --target universal-apple-darwin --config src-tauri/tauri.macos.conf.json",
    "build:macos:ci": "bun tauri build --bundles app,dmg --target universal-apple-darwin --config src-tauri/tauri.macos-ci.conf.json",
    "check": "bun run i18n:check && tsc --noEmit && bun run --cwd packages/integration check",
    "integration:build": "bun run --cwd packages/integration build",
    "integration:rust:check": "cargo check --manifest-path packages/rust/Cargo.toml",
    "integration:rust:test": "cargo test --manifest-path packages/rust/Cargo.toml",
    "integration:rust:publish-dry-run": "cargo publish --dry-run --manifest-path packages/rust/Cargo.toml",
    "docs:audit": "bun scripts/docs-audit.ts",
    "i18n:check": "bun scripts/i18n-check.ts",
    "i18n:status": "bun scripts/i18n-status.ts",
    "i18n:status:write": "bun scripts/i18n-status.ts --write",
    "changelog:write": "bun scripts/generate-changelog.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run src packages/integration/test scripts/release-channel.test.ts scripts/release-notes.test.ts scripts/updater-manifest.test.ts",
    "test:e2e": "playwright test",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "preview": "vite preview",
    "preview:tauri": "bun scripts/tauri-preview.ts dev",
    "build:preview": "bun scripts/tauri-preview.ts build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
